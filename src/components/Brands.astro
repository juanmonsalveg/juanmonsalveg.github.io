---
import type { Resume, UiStrings } from '../types/resume';

interface Props {
  resume: Resume;
  ui: UiStrings;
}

const { resume, ui } = Astro.props;
const brands = resume.brands ?? [];
---

{brands.length > 0 && (
  <section class="brands mb-12 border-y border-muted py-4 sm:mb-14 sm:py-5" aria-labelledby="brands-heading">
    <h2 id="brands-heading" class="text-xs font-semibold tracking-wider text-muted uppercase">
      {ui.brandsHeading}
    </h2>
    <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-base font-semibold tracking-tight text-primary sm:text-lg">
      {brands.map((brand) => (
        <li>{brand}</li>
      ))}
    </ul>
  </section>
)}
