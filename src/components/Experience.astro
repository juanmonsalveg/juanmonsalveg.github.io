---
import type { Locale, Resume, UiStrings } from '../types/resume';
import { formatDateRange } from '../lib/resume';
import Section from './Section.astro';

interface Props {
  resume: Resume;
  ui: UiStrings;
  locale: Locale;
}

const { resume, ui, locale } = Astro.props;
---

<Section id="experience" title={ui.navExperience}>
  <ol class="job-list">
    {
      resume.work.map((job) => {
        const highlights = job.highlights && job.highlights.length > 0 && (
          <ul class="achievement-list mt-3 list-disc space-y-1 pl-5 text-body text-muted sm:space-y-1.5">
            {job.highlights.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        );
        const technologies = job.technologies && job.technologies.length > 0 && (
          <ul class="tool-list mt-3 flex flex-wrap sm:gap-2" aria-label={ui.technologies}>
            {job.technologies.map((tool) => (
              <li class="tool-tag">{tool}</li>
            ))}
          </ul>
        );
        const hasDetails = Boolean(highlights || technologies);

        return (
          <li
            class:list={[
              'job print-break-inside-avoid border-l-2 border-muted pl-5 transition',
              job.compact ? 'job-compact not-first:mt-6' : 'not-first:mt-8 hover:border-accent sm:not-first:mt-10',
            ]}
          >
            <article>
              <h3 class:list={['font-semibold text-primary', job.compact ? 'text-base' : 'text-lg']}>
                {job.name}
              </h3>
              <p class="job-meta mt-1 flex flex-col text-sm font-medium text-muted sm:flex-row sm:flex-wrap sm:items-baseline">
                <span>{job.position}</span>
                <span class="mx-2 hidden opacity-40 sm:inline" aria-hidden="true">
                  ·
                </span>
                <time datetime={job.startDate} class="whitespace-nowrap text-primary">
                  {formatDateRange(job.startDate, job.endDate, ui.present, locale)}
                </time>
              </p>
              {job.summary && (
                <p class:list={['job-summary text-muted', job.compact ? 'mt-1.5 text-sm leading-relaxed' : 'mt-3 text-body']}>
                  {job.summary}
                </p>
              )}
              {job.compact && hasDetails ? (
                <details class="job-details">
                  <summary class="details-toggle no-print">
                    <span class="when-closed">{ui.showDetails}</span>
                    <span class="when-open">{ui.hideDetails}</span>
                    <span class="sr-only">: {job.name}</span>
                  </summary>
                  {highlights}
                  {technologies}
                </details>
              ) : (
                <>
                  {highlights}
                  {technologies}
                </>
              )}
            </article>
          </li>
        );
      })
    }
  </ol>
</Section>

<script>
  // Print every compact entry expanded (Ctrl/Cmd+P). The PDF script opens them explicitly.
  const reopened = new Set<HTMLDetailsElement>();
  window.addEventListener('beforeprint', () => {
    document.querySelectorAll<HTMLDetailsElement>('details.job-details:not([open])').forEach((el) => {
      el.open = true;
      reopened.add(el);
    });
  });
  window.addEventListener('afterprint', () => {
    reopened.forEach((el) => (el.open = false));
    reopened.clear();
  });
</script>
