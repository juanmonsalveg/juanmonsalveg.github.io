---
import type { Resume, UiStrings } from '../types/resume';
import { formatYear } from '../lib/resume';
import Section from './Section.astro';

interface Props {
  resume: Resume;
  ui: UiStrings;
}

const { resume, ui } = Astro.props;
---

<Section id="education" title={ui.navEducation}>
  <ul class="space-y-8">
    {
      resume.education.map((edu) => (
        <li class="print-break-inside-avoid border-l-2 border-muted pl-5">
          <h3 class="text-lg font-semibold text-primary">{edu.institution}</h3>
          <p class="mt-1 text-sm font-medium text-muted">
            {[edu.studyType, edu.area].filter(Boolean).join(' · ')}
            {edu.endDate && (
              <>
                <span class="mx-2 opacity-40" aria-hidden="true">·</span>
                <time datetime={formatYear(edu.endDate)} class="text-primary">
                  {formatYear(edu.endDate)}
                </time>
              </>
            )}
          </p>
        </li>
      ))
    }
  </ul>
</Section>
