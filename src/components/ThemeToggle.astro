---
import type { UiStrings } from '../types/resume';
import Sun from './icons/Sun.astro';
import Moon from './icons/Moon.astro';
import Monitor from './icons/Monitor.astro';

interface Props {
  ui: UiStrings;
}

const { ui } = Astro.props;
---

<div class="no-print seg-group" role="group" aria-label={ui.themeToggleAria}>
  <button
    type="button"
    data-theme="light"
    class="theme-btn seg-btn"
    aria-pressed="false"
    aria-label={`${ui.themeToggleAria}: ${ui.themeLight}`}
  >
    <span class="seg-chip"><Sun class="icon" size={14} /></span>
  </button>
  <button
    type="button"
    data-theme="system"
    class="theme-btn seg-btn"
    aria-pressed="false"
    aria-label={`${ui.themeToggleAria}: ${ui.themeSystem}`}
  >
    <span class="seg-chip"><Monitor class="icon" size={14} /></span>
  </button>
  <button
    type="button"
    data-theme="dark"
    class="theme-btn seg-btn"
    aria-pressed="false"
    aria-label={`${ui.themeToggleAria}: ${ui.themeDark}`}
  >
    <span class="seg-chip"><Moon class="icon" size={14} /></span>
  </button>
</div>

<script>
  const storageKey = 'theme';
  const root = document.documentElement;
  const buttons = document.querySelectorAll<HTMLButtonElement>('.theme-btn');

  function getStored(): string {
    return localStorage.getItem(storageKey) ?? 'system';
  }

  function prefersDark(): boolean {
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  function applyTheme(mode: string) {
    const isDark = mode === 'dark' || (mode === 'system' && prefersDark());
    root.classList.toggle('dark', isDark);
    buttons.forEach((btn) => {
      btn.setAttribute('aria-pressed', String(btn.dataset.theme === mode));
    });
  }

  function setTheme(mode: string) {
    localStorage.setItem(storageKey, mode);
    applyTheme(mode);
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.theme ?? 'system';
      setTheme(mode);
    });
  });

  applyTheme(getStored());

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
    if (getStored() === 'system') applyTheme('system');
  });
</script>
