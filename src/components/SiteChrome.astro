---
import type { Locale, Resume, UiStrings } from '../types/resume';
import { getNavSections, getPdfPath } from '../lib/resume';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';
import Download from './icons/Download.astro';

interface Props {
  locale: Locale;
  resume: Resume;
  ui: UiStrings;
}

const { locale, resume, ui } = Astro.props;
const pdfPath = getPdfPath(locale);
const navItems = getNavSections(resume, ui);
---

<a href="#main" class="skip-link no-print">{ui.skipToContent}</a>
<header class="no-print sticky top-0 z-50 border-b border-muted bg-surface/90 backdrop-blur-md">
  <div class="mx-auto flex max-w-3xl items-center gap-2 px-4 py-1 sm:gap-3 sm:px-6">
    <nav class="scroll-row -ml-2 hidden min-w-0 flex-1 sm:block" aria-label={ui.sectionNavAria}>
      <ul class="flex">
        {
          navItems.map((item) => (
            <li>
              <a href={`#${item.id}`} class="nav-link">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="ml-auto flex shrink-0 items-center gap-1.5 sm:gap-2">
      <div class="seg-group">
        <a
          href={pdfPath}
          download={`resume-${locale}.pdf`}
          class="seg-btn text-primary"
          aria-label={ui.downloadPdfAria}
        >
          <span class="seg-chip">
            <Download class="icon" size={14} />
            <span class="hidden md:inline">{ui.downloadPdf}</span>
          </span>
        </a>
      </div>
      <LanguageSwitcher locale={locale} />
      <ThemeToggle ui={ui} />
    </div>
  </div>
</header>
