---
import type { Resume, UiStrings } from '../types/resume';
import { hasSection } from '../lib/resume';
import Section from './Section.astro';

interface Props {
  resume: Resume;
  ui: UiStrings;
}

const { resume, ui } = Astro.props;
const caseStudies = resume.caseStudies ?? [];
---

{hasSection(resume, 'case-studies') && (
  <Section id="case-studies" title={ui.navCaseStudies}>
    <div class="grid gap-5">
      {caseStudies.map((study) => (
        <article class="card print-break-inside-avoid">
          <h3 class="text-lg font-semibold text-primary">{study.title}</h3>
          <p class="mt-2 text-body text-muted">{study.summary}</p>
          {study.highlights && study.highlights.length > 0 && (
            <ul class="achievement-list mt-3 list-disc space-y-1.5 pl-5 text-body text-muted">
              {study.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          )}
          {study.technologies && study.technologies.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-2" aria-label={ui.technologies}>
              {study.technologies.map((tool) => (
                <li class="tool-tag">{tool}</li>
              ))}
            </ul>
          )}
          {study.url && (
            <a href={study.url} class="text-link mt-3 inline-flex min-h-11 items-center text-sm font-semibold">
              {ui.caseStudyLink}
              <span class="sr-only">: {study.title}</span>
            </a>
          )}
        </article>
      ))}
    </div>
  </Section>
)}
