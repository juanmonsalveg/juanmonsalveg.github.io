---
import type { Resume, UiStrings } from '../types/resume';
import Section from './Section.astro';

interface Props {
  resume: Resume;
  ui: UiStrings;
}

const { resume, ui } = Astro.props;
---

<Section id="skills" title={ui.navSkills}>
  <div class="skills-grid grid-fill-last grid gap-6 sm:grid-cols-2 sm:gap-5">
    {
      resume.skills.map((group) => (
        <div class="card card-flat-mobile print-break-inside-avoid">
          <h3 class="font-semibold text-primary">{group.name}</h3>
          {group.keywords && group.keywords.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-1.5 sm:mt-4 sm:gap-2">
              {group.keywords.map((keyword) => (
                <li class="skill-tag">{keyword}</li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </div>
</Section>
