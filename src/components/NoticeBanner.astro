---
import type { UiStrings } from '../types/resume';

interface Props {
  ui: UiStrings;
}

const { ui } = Astro.props;
---

{ui.noticeBanner && (
  <p class="no-print mb-8 flex items-start gap-2 text-sm text-muted">
    <svg
      class="mt-0.5 h-4 w-4 shrink-0 text-accent"
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        fill-rule="evenodd"
        d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a.75.75 0 000 1.5h.253a.25.25 0 01.244.194l-.458 2.066A1.75 1.75 0 0010.747 15H11a.75.75 0 000-1.5h-.253a.25.25 0 01-.244-.194l.458-2.066A1.75 1.75 0 009.253 9H9z"
        clip-rule="evenodd"></path>
    </svg>
    <span>{ui.noticeBanner}</span>
  </p>
)}
