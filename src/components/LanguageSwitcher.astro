---
import type { Locale } from '../types/resume';
import { getUi } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = getUi(locale);
---

<nav class="no-print seg-group" aria-label={ui.languageSwitcherAria}>
  <a
    href="/en/"
    class="seg-btn"
    aria-current={locale === 'en' ? 'page' : undefined}
    hreflang="en"
    lang="en"
    aria-label="English"
  >
    <span class="seg-chip">EN</span>
  </a>
  <a
    href="/es/"
    class="seg-btn"
    aria-current={locale === 'es' ? 'page' : undefined}
    hreflang="es"
    lang="es"
    aria-label="Español"
  >
    <span class="seg-chip">ES</span>
  </a>
</nav>
