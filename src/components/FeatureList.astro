---
import type { ResumeFeatureItem } from '../types/resume';

interface Props {
  items: ResumeFeatureItem[];
}

const { items } = Astro.props;
---

<ul class="grid-fill-last grid gap-5 sm:grid-cols-2">
  {
    items.map((item) => (
      <li class="card print-break-inside-avoid">
        <h3 class="font-semibold text-primary">{item.title}</h3>
        <p class="mt-2 text-body text-muted">{item.description}</p>
      </li>
    ))
  }
</ul>
